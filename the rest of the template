## 21. `src/components/ArenaWallet/ArenaWallet.tsx`

```tsx
import React, { useState } from 'react';
import { 
  Wallet, 
  Copy, 
  Check, 
  Send, 
  RefreshCw,
  User,
  ExternalLink,
} from 'lucide-react';
import type { UserProfile } from '../../types';
import './ArenaWallet.css';

interface ArenaWalletProps {
  isConnected: boolean;
  walletAddress: string | null;
  balance: string | null;
  userProfile: UserProfile | null;
  onRefreshBalance: () => Promise<void>;
  onSendTransaction: (to: string, amount: string) => Promise<string | null>;
  className?: string;
}

export const ArenaWallet: React.FC<ArenaWalletProps> = ({
  isConnected,
  walletAddress,
  balance,
  userProfile,
  onRefreshBalance,
  onSendTransaction,
  className = '',
}) => {
  const [copied, setCopied] = useState(false);
  const [isRefreshing, setIsRefreshing] = useState(false);
  const [showSend, setShowSend] = useState(false);
  const [sendTo, setSendTo] = useState('');
  const [sendAmount, setSendAmount] = useState('');
  const [isSending, setIsSending] = useState(false);

  const handleCopyAddress = async () => {
    if (walletAddress) {
      await navigator.clipboard.writeText(walletAddress);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    }
  };

  const handleRefresh = async () => {
    setIsRefreshing(true);
    await onRefreshBalance();
    setIsRefreshing(false);
  };

  const handleSend = async () => {
    if (!sendTo || !sendAmount) return;
    
    setIsSending(true);
    try {
      await onSendTransaction(sendTo, sendAmount);
      setShowSend(false);
      setSendTo('');
      setSendAmount('');
      await onRefreshBalance();
    } catch (error) {
      console.error('Transaction failed:', error);
    } finally {
      setIsSending(false);
    }
  };

  const truncateAddress = (address: string) => {
    return `${address.slice(0, 6)}...${address.slice(-4)}`;
  };

  if (!isConnected) {
    return (
      <div className={`arena-wallet arena-wallet--disconnected ${className}`}>
        <Wallet size={24} />
        <p>Wallet not connected</p>
      </div>
    );
  }

  return (
    <div className={`arena-wallet ${className}`}>
      {/* User Profile */}
      {userProfile && (
        <div className="arena-wallet__profile">
          <img 
            src={userProfile.userImageUrl} 
            alt={userProfile.username}
            className="arena-wallet__avatar"
          />
          <div className="arena-wallet__profile-info">
            <span className="arena-wallet__username">{userProfile.userName}</span>
            <span className="arena-wallet__handle">@{userProfile.userHandle}</span>
          </div>
        </div>
      )}

      {/* Wallet Address */}
      <div className="arena-wallet__address">
        <span className="arena-wallet__label">Wallet</span>
        <div className="arena-wallet__address-row">
          <code>{walletAddress ? truncateAddress(walletAddress) : '...'}</code>
          <button onClick={handleCopyAddress} title="Copy address">
            {copied ? <Check size={14} /> : <Copy size={14} />}
          </button>
        </div>
      </div>

      {/* Balance */}
      <div className="arena-wallet__balance">
        <span className="arena-wallet__label">Balance</span>
        <div className="arena-wallet__balance-row">
          <span className="arena-wallet__balance-value">
            {balance ? `${parseFloat(balance).toFixed(4)} AVAX` : '...'}
          </span>
          <button 
            onClick={handleRefresh} 
            disabled={isRefreshing}
            title="Refresh balance"
          >
            <RefreshCw size={14} className={isRefreshing ? 'animate-spin' : ''} />
          </button>
        </div>
      </div>

      {/* Stats */}
      {userProfile && (
        <div className="arena-wallet__stats">
          <div className="arena-wallet__stat">
            <span className="arena-wallet__stat-value">{userProfile.followerCount}</span>
            <span className="arena-wallet__stat-label">Followers</span>
          </div>
          <div className="arena-wallet__stat">
            <span className="arena-wallet__stat-value">{userProfile.ticketHolders}</span>
            <span className="arena-wallet__stat-label">Holders</span>
          </div>
          <div className="arena-wallet__stat">
            <span className="arena-wallet__stat-value">{userProfile.tokenHoldings}</span>
            <span className="arena-wallet__stat-label">Holdings</span>
          </div>
        </div>
      )}

      {/* Send Button */}
      <button 
        className="arena-wallet__send-btn"
        onClick={() => setShowSend(!showSend)}
      >
        <Send size={16} />
        Send AVAX
      </button>

      {/* Send Form */}
      {showSend && (
        <div className="arena-wallet__send-form">
          <input
            type="text"
            placeholder="Recipient address (0x...)"
            value={sendTo}
            onChange={(e) => setSendTo(e.target.value)}
          />
          <input
            type="number"
            placeholder="Amount (AVAX)"
            value={sendAmount}
            onChange={(e) => setSendAmount(e.target.value)}
            step="0.001"
            min="0"
          />
          <button 
            onClick={handleSend}
            disabled={!sendTo || !sendAmount || isSending}
            className="arena-wallet__confirm-btn"
          >
            {isSending ? 'Sending...' : 'Confirm Send'}
          </button>
        </div>
      )}
    </div>
  );
};
