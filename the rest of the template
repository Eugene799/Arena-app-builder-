```tsx
import React, { useState, useCallback } from 'react';
import { 
  RefreshCw, 
  ExternalLink, 
  Smartphone, 
  Monitor, 
  Tablet,
  QrCode,
  X,
  Copy,
  Check,
} from 'lucide-react';
import { QRCodeSVG } from 'qrcode.react';
import './Preview.css';

interface PreviewProps {
  url: string | null;
  isLoading?: boolean;
  className?: string;
}

type DeviceMode = 'desktop' | 'tablet' | 'mobile';

const DEVICE_SIZES: Record<DeviceMode, { width: string; height: string }> = {
  desktop: { width: '100%', height: '100%' },
  tablet: { width: '768px', height: '1024px' },
  mobile: { width: '375px', height: '667px' },
};

export const Preview: React.FC<PreviewProps> = ({
  url,
  isLoading = false,
  className = '',
}) => {
  const [deviceMode, setDeviceMode] = useState<DeviceMode>('desktop');
  const [showQR, setShowQR] = useState(false);
  const [copied, setCopied] = useState(false);
  const [iframeKey, setIframeKey] = useState(0);

  const handleRefresh = useCallback(() => {
    setIframeKey(prev => prev + 1);
  }, []);

  const handleCopyUrl = useCallback(async () => {
    if (url) {
      await navigator.clipboard.writeText(url);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    }
  }, [url]);

  const handleOpenExternal = useCallback(() => {
    if (url) {
      window.open(url, '_blank');
    }
  }, [url]);

  return (
    <div className={`preview ${className}`}>
      {/* Toolbar */}
      <div className="preview__toolbar">
        <div className="preview__device-switcher">
          <button
            className={deviceMode === 'desktop' ? 'active' : ''}
            onClick={() => setDeviceMode('desktop')}
            title="Desktop"
          >
            <Monitor size={18} />
          </button>
          <button
            className={deviceMode === 'tablet' ? 'active' : ''}
            onClick={() => setDeviceMode('tablet')}
            title="Tablet"
          >
            <Tablet size={18} />
          </button>
          <button
            className={deviceMode === 'mobile' ? 'active' : ''}
            onClick={() => setDeviceMode('mobile')}
            title="Mobile"
          >
            <Smartphone size={18} />
          </button>
        </div>

        <div className="preview__url-bar">
          <input
            type="text"
            value={url || 'Not running'}
            readOnly
            className="preview__url-input"
          />
        </div>

        <div className="preview__actions">
          <button onClick={handleRefresh} title="Refresh">
            <RefreshCw size={18} className={isLoading ? 'animate-spin' : ''} />
          </button>
          <button onClick={() => setShowQR(true)} title="QR Code" disabled={!url}>
            <QrCode size={18} />
          </button>
          <button onClick={handleOpenExternal} title="Open in new tab" disabled={!url}>
            <ExternalLink size={18} />
          </button>
        </div>
      </div>

      {/* Preview Frame */}
      <div className="preview__frame-container">
        {url ? (
          <div
            className={`preview__frame-wrapper preview__frame-wrapper--${deviceMode}`}
            style={deviceMode !== 'desktop' ? {
              width: DEVICE_SIZES[deviceMode].width,
              height: DEVICE_SIZES[deviceMode].height,
            } : undefined}
          >
            <iframe
              key={iframeKey}
              src={url}
              className="preview__iframe"
              title="App Preview"
              sandbox="allow-scripts allow-same-origin allow-forms allow-modals"
            />
          </div>
        ) : (
          <div className="preview__empty">
            <Monitor size={48} />
            <p>Start the dev server to see preview</p>
          </div>
        )}
      </div>

      {/* QR Code Modal */}
      {showQR && url && (
        <div className="preview__qr-modal" onClick={() => setShowQR(false)}>
          <div className="preview__qr-content" onClick={(e) => e.stopPropagation()}>
            <button className="preview__qr-close" onClick={() => setShowQR(false)}>
              <X size={20} />
            </button>
            <h3>Scan to preview on device</h3>
            <div className="preview__qr-code">
              <QRCodeSVG value={url} size={200} />
            </div>
            <div className="preview__qr-url">
              <input type="text" value={url} readOnly />
              <button onClick={handleCopyUrl}>
                {copied ? <Check size={18} /> : <Copy size={18} />}
              </button>
            </div>
            <p className="preview__qr-note">
              Ensure your device is on the same network
            </p>
          </div>
        </div>
      )}
    </div>
  );
};
