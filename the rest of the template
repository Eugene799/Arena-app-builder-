  onClose?: () => void;
}

export const Terminal: React.FC<TerminalProps> = ({
  onCommand,
  className = '',
  isExpanded = false,
  onToggleExpand,
  onClose,
}) => {
  const terminalRef = useRef<HTMLDivElement>(null);
  const xtermRef = useRef<XTerm | null>(null);
  const inputBuffer = useRef<string>('');

  const writePrompt = useCallback(() => {
    xtermRef.current?.write('\r\n\x1b[32m❯\x1b[0m ');
  }, []);

  useEffect(() => {
    if (!terminalRef.current) return;

    const term = new XTerm({
      theme: {
        background: '#11111b',
        foreground: '#cdd6f4',
        cursor: '#f5e0dc',
        cursorAccent: '#11111b',
        selectionBackground: '#45475a',
        black: '#45475a',
        red: '#f38ba8',
        green: '#a6e3a1',
        yellow: '#f9e2af',
        blue: '#89b4fa',
        magenta: '#cba6f7',
        cyan: '#94e2d5',
        white: '#bac2de',
        brightBlack: '#585b70',
        brightRed: '#f38ba8',
        brightGreen: '#a6e3a1',
        brightYellow: '#f9e2af',
        brightBlue: '#89b4fa',
        brightMagenta: '#cba6f7',
        brightCyan: '#94e2d5',
        brightWhite: '#a6adc8',
      },
      fontFamily: '"Fira Code", "SF Mono", monospace',
      fontSize: 14,
      cursorBlink: true,
      cursorStyle: 'bar',
      convertEol: true,
    });

    term.open(terminalRef.current);
    xtermRef.current = term;

    // Welcome message
    term.writeln('\x1b[36m╭──────────────────────────────────────╮\x1b[0m');
    term.writeln('\x1b[36m│\x1b[0m  \x1b[1m🚀 Arena AI Builder Terminal\x1b[0m       \x1b[36m│\x1b[0m');
    term.writeln('\x1b[36m│\x1b[0m  Type commands to interact           \x1b[36m│\x1b[0m');
    term.writeln('\x1b[36m╰──────────────────────────────────────╯\x1b[0m');
    writePrompt();

    // Handle input
    term.onData((data) => {
      const code = data.charCodeAt(0);

      if (code === 13) { // Enter
        const command = inputBuffer.current.trim();
        inputBuffer.current = '';
        term.write('\r\n');
        
        if (command) {
          onCommand?.(command);
        }
        writePrompt();
      } else if (code === 127) { // Backspace
        if (inputBuffer.current.length > 0) {
          inputBuffer.current = inputBuffer.current.slice(0, -1);
          term.write('\b \b');
        }
      } else if (code >= 32) { // Printable characters
        inputBuffer.current += data;
        term.write(data);
      }
    });

    return () => {
      term.dispose();
    };
  }, [onCommand, writePrompt]);

  // Expose write method for external use
  const write = useCallback((text: string) => {
    xtermRef.current?.write(text);
  }, []);

  const writeLine = useCallback((text: string) => {
    xtermRef.current?.writeln(text);
  }, []);

  return (
    <div className={`terminal ${isExpanded ? 'terminal--expanded' : ''} ${className}`}>
      <div className="terminal__header">
        <span className="terminal__title">Terminal</span>
        <div className="terminal__controls">
          {onToggleExpand && (
            <button onClick={onToggleExpand}>
              {isExpanded ? <Minimize2 size={14} /> : <Maximize2 size={14} />}
            </button>
          )}
          {onClose && (
            <button onClick={onClose}>
              <X size={14} />
            </button>
          )}
        </div>
      </div>
      <div ref={terminalRef} className="terminal__content" />
    </div>
  );
};
