import { useState, useRef, useEffect, useCallback } from 'react';
import { ethers } from 'ethers';
import type { UserProfile } from '../types';

interface ArenaSDKState {
  isConnected: boolean;
  walletAddress: string | null;
  balance: string | null;
  userProfile: UserProfile | null;
  chainId: number | null;
  error: string | null;
}

export function useArenaSDK() {
  const [state, setState] = useState<ArenaSDKState>({
    isConnected: false,
    walletAddress: null,
    balance: null,
    userProfile: null,
    chainId: null,
    error: null,
  });

  const sdkRef = useRef<any>(null);
  const providerRef = useRef<any>(null);

  const initialize = useCallback(async (sdk: any) => {
    sdkRef.current = sdk;
    providerRef.current = sdk?.provider;

    if (providerRef.current?.accounts?.[0]) {
      const address = providerRef.current.accounts[0];
      setState(prev => ({
        ...prev,
        isConnected: true,
        walletAddress: address,
      }));
      
      // Fetch initial data
      await Promise.all([
        fetchBalance(),
        fetchUserProfile(),
      ]);
    }
  }, []);

  const fetchBalance = useCallback(async (): Promise<string | null> => {
    if (!providerRef.current?.accounts?.[0]) return null;

    try {
      const balance = await providerRef.current.request({
        method: 'eth_getBalance',
        params: [providerRef.current.accounts[0], 'latest'],
      });

      const balanceInAvax = ethers.formatEther(balance);
      setState(prev => ({ ...prev, balance: balanceInAvax }));
      return balanceInAvax;
    } catch (error) {
      console.error('Failed to fetch balance:', error);
      return null;
    }
  }, []);

  const fetchUserProfile = useCallback(async (): Promise<UserProfile | null> => {
    if (!sdkRef.current) return null;

    try {
      const profile = await sdkRef.current.fetchUserProfile();
      setState(prev => ({ ...prev, userProfile: profile }));
      return profile;
    } catch (error) {
      console.error('Failed to fetch user profile:', error);
      return null;
    }
  }, []);

  const sendTransaction = useCallback(async (
    toAddress: string,
    amount: string
  ): Promise<string | null> => {
    if (!providerRef.current?.accounts?.[0]) {
      throw new Error('Wallet not connected');
    }

    try {
      const txHash = await providerRef.current.request({
        method: 'eth_sendTransaction',
        params: [{
          from: providerRef.current.accounts[0],
          to: toAddress,
          value: ethers.parseEther(amount).toString(16),
        }],
      });

      return txHash;
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Transaction failed';
      setState(prev => ({ ...prev, error: message }));
      throw error;
    }
  }, []);

  const signMessage = useCallback(async (message: string): Promise<{
    signature: string;
    signerAddress: string;
  }> => {
    if (!providerRef.current?.accounts?.[0]) {
      throw new Error('Wallet not connected');
    }

    const hexMessage = `0x${Buffer.from(message, 'utf8').toString('hex')}`;
    const signature = await providerRef.current.request({
      method: 'personal_sign',
      params: [hexMessage, providerRef.current.accounts[0]],
    });

    const signerAddress = ethers.verifyMessage(message, signature);

    return { signature, signerAddress };
  }, []);

  const signUserProfile = useCallback(async (): Promise<{
    profile: UserProfile;
    signature: string;
    signerAddress: string;
  } | null> => {
    const profile = await fetchUserProfile();
    if (!profile) throw new Error('Failed to fetch profile');

    const profileStr = JSON.stringify(profile);
    const { signature, signerAddress } = await signMessage(profileStr);

    return { profile, signature, signerAddress };
  }, [fetchUserProfile, signMessage]);

  return {
    ...state,
    sdkRef,
    initialize,
    fetchBalance,
    fetchUserProfile,
    sendTransaction,
    signMessage,
    signUserProfile,
  };
}
