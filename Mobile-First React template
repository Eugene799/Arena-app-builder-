import { useState, useCallback } from 'react';
import type { SubscriptionPlan, UserSubscription } from '../types';

export const SUBSCRIPTION_PLANS: SubscriptionPlan[] = [
  {
    id: 'starter',
    name: 'Starter',
    price: 5.99,
    appsLimit: 2,
    messagesLimit: 14,
    features: [
      '2 public/private apps',
      '14 AI messages per month',
      'Basic templates',
      'Community support',
    ],
  },
  {
    id: 'pro',
    name: 'Pro',
    price: 15.99,
    appsLimit: 9,
    messagesLimit: 50,
    features: [
      '9 public/private apps',
      '50 AI messages per month',
      'Advanced templates',
      'Priority support',
      'Custom domains',
      'Agent merging',
    ],
  },
  {
    id: 'premium',
    name: 'Premium',
    price: 29.99,
    appsLimit: 25,
    messagesLimit: 120,
    features: [
      '25 public/private apps',
      '120 AI messages per month',
      'All templates',
      '24/7 Premium support',
      'Custom domains',
      'Agent merging',
      'White-label deployments',
      'API access',
    ],
  },
];

export function useSubscription() {
  const [subscription, setSubscription] = useState<UserSubscription | null>(null);
  const [isLoading, setIsLoading] = useState(false);

  const getCurrentPlan = useCallback((): SubscriptionPlan | null => {
    if (!subscription) return null;
    return SUBSCRIPTION_PLANS.find(p => p.id === subscription.planId) || null;
  }, [subscription]);

  const canCreateApp = useCallback((): boolean => {
    const plan = getCurrentPlan();
    if (!plan || !subscription) return false;
    return subscription.appsUsed < plan.appsLimit;
  }, [getCurrentPlan, subscription]);

  const canSendMessage = useCallback((): boolean => {
    const plan = getCurrentPlan();
    if (!plan || !subscription) return false;
    return subscription.messagesUsed < plan.messagesLimit;
  }, [getCurrentPlan, subscription]);

  const getRemainingMessages = useCallback((): number => {
    const plan = getCurrentPlan();
    if (!plan || !subscription) return 0;
    return Math.max(0, plan.messagesLimit - subscription.messagesUsed);
  }, [getCurrentPlan, subscription]);

  const getRemainingApps = useCallback((): number => {
    const plan = getCurrentPlan();
    if (!plan || !subscription) return 0;
    return Math.max(0, plan.appsLimit - subscription.appsUsed);
  }, [getCurrentPlan, subscription]);

  const incrementMessageCount = useCallback(() => {
    setSubscription(prev => {
      if (!prev) return null;
      return { ...prev, messagesUsed: prev.messagesUsed + 1 };
    });
  }, []);

  const incrementAppCount = useCallback(() => {
    setSubscription(prev => {
      if (!prev) return null;
      return { ...prev, appsUsed: prev.appsUsed + 1 };
    });
  }, []);

  const subscribe = useCallback(async (planId: string, paymentMethod: 'avax' | 'card') => {
    setIsLoading(true);
    try {
      // Integration with payment processor would go here
      // For AVAX payments, use the Arena SDK
      const newSubscription: UserSubscription = {
        planId,
        appsUsed: 0,
        messagesUsed: 0,
        expiresAt: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000), // 30 days
      };
      setSubscription(newSubscription);
      return newSubscription;
    } finally {
      setIsLoading(false);
    }
  }, []);

  return {
    subscription,
    isLoading,
    plans: SUBSCRIPTION_PLANS,
    getCurrentPlan,
    canCreateApp,
    canSendMessage,
    getRemainingMessages,
    getRemainingApps,
    incrementMessageCount,
    incrementAppCount,
    subscribe,
  };
}
