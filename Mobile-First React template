import { useState, useEffect, useRef, useCallback } from 'react';
import { WebContainer } from '@webcontainer/api';
import type { FileNode } from '../types';

interface WebContainerState {
  instance: WebContainer | null;
  isBooting: boolean;
  isReady: boolean;
  previewUrl: string | null;
  error: string | null;
}

export function useWebContainer() {
  const [state, setState] = useState<WebContainerState>({
    instance: null,
    isBooting: false,
    isReady: false,
    previewUrl: null,
    error: null,
  });
  
  const instanceRef = useRef<WebContainer | null>(null);

  const boot = useCallback(async () => {
    if (instanceRef.current) return instanceRef.current;

    setState(prev => ({ ...prev, isBooting: true, error: null }));

    try {
      const instance = await WebContainer.boot();
      instanceRef.current = instance;

      // Listen for server-ready events
      instance.on('server-ready', (port, url) => {
        setState(prev => ({ ...prev, previewUrl: url }));
      });

      setState(prev => ({
        ...prev,
        instance,
        isBooting: false,
        isReady: true,
      }));

      return instance;
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Failed to boot WebContainer';
      setState(prev => ({
        ...prev,
        isBooting: false,
        error: message,
      }));
      throw error;
    }
  }, []);

  const writeFile = useCallback(async (path: string, content: string) => {
    if (!instanceRef.current) throw new Error('WebContainer not initialized');
    await instanceRef.current.fs.writeFile(path, content);
  }, []);

  const readFile = useCallback(async (path: string): Promise<string> => {
    if (!instanceRef.current) throw new Error('WebContainer not initialized');
    return await instanceRef.current.fs.readFile(path, 'utf-8');
  }, []);

  const mkdir = useCallback(async (path: string) => {
    if (!instanceRef.current) throw new Error('WebContainer not initialized');
    await instanceRef.current.fs.mkdir(path, { recursive: true });
  }, []);

  const spawn = useCallback(async (command: string, args: string[] = []) => {
    if (!instanceRef.current) throw new Error('WebContainer not initialized');
    return instanceRef.current.spawn(command, args);
  }, []);

  const mountFiles = useCallback(async (files: Record<string, any>) => {
    if (!instanceRef.current) throw new Error('WebContainer not initialized');
    await instanceRef.current.mount(files);
  }, []);

  const installDependencies = useCallback(async (onOutput?: (data: string) => void) => {
    const process = await spawn('npm', ['install']);
    
    process.output.pipeTo(new WritableStream({
      write(data) {
        onOutput?.(data);
      }
    }));

    const exitCode = await process.exit;
    if (exitCode !== 0) {
      throw new Error(`npm install failed with exit code ${exitCode}`);
    }
  }, [spawn]);

  const startDevServer = useCallback(async (onOutput?: (data: string) => void) => {
    const process = await spawn('npm', ['run', 'dev']);
    
    process.output.pipeTo(new WritableStream({
      write(data) {
        onOutput?.(data);
      }
    }));

    return process;
  }, [spawn]);

  // Cleanup on unmount
  useEffect(() => {
    return () => {
      instanceRef.current?.teardown();
    };
  }, []);

  return {
    ...state,
    boot,
    writeFile,
    readFile,
    mkdir,
    spawn,
    mountFiles,
    installDependencies,
    startDevServer,
  };
}
