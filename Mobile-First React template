## 12. `src/components/AIChat/AIChat.tsx`

```tsx
import React, { useState, useRef, useEffect, useCallback } from 'react';
import { Send, Sparkles, Code, Loader2 } from 'lucide-react';
import { useVisualViewport } from '../../hooks/useVisualViewport';
import { MessageBubble } from './MessageBubble';
import type { Message, CodeBlock } from '../../types';
import './AIChat.css';

interface AIChatProps {
  messages: Message[];
  onSendMessage: (content: string) => Promise<void>;
  onApplyCode: (codeBlocks: CodeBlock[]) => void;
  isLoading: boolean;
  remainingMessages: number;
  className?: string;
}

export const AIChat: React.FC<AIChatProps> = ({
  messages,
  onSendMessage,
  onApplyCode,
  isLoading,
  remainingMessages,
  className = '',
}) => {
  const [input, setInput] = useState('');
  const messagesEndRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLTextAreaElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);
  const viewport = useVisualViewport();

  // Auto-scroll to bottom on new messages
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  // Adjust container height when keyboard opens (mobile)
  useEffect(() => {
    if (containerRef.current && viewport.isKeyboardOpen) {
      containerRef.current.style.height = `${viewport.height}px`;
      containerRef.current.style.transform = `translateY(${viewport.offsetTop}px)`;
    } else if (containerRef.current) {
      containerRef.current.style.height = '';
      containerRef.current.style.transform = '';
    }
  }, [viewport]);

  const handleSubmit = useCallback(async (e?: React.FormEvent) => {
    e?.preventDefault();
    const trimmedInput = input.trim();
    
    if (!trimmedInput || isLoading || remainingMessages <= 0) return;

    setInput('');
    await onSendMessage(trimmedInput);
  }, [input, isLoading, remainingMessages, onSendMessage]);

  const handleKeyDown = useCallback((e: React.KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSubmit();
    }
  }, [handleSubmit]);

  // Auto-resize textarea
  const handleInputChange = useCallback((e: React.ChangeEvent<HTMLTextAreaElement>) => {
    setInput(e.target.value);
    const textarea = e.target;
    textarea.style.height = 'auto';
    textarea.style.height = `${Math.min(textarea.scrollHeight, 120)}px`;
  }, []);

  const suggestedPrompts = [
    "Create a landing page with hero section",
    "Build a todo app with local storage",
    "Make a portfolio website template",
    "Create a contact form with validation",
  ];

  return (
    <div ref={containerRef} className={`ai-chat ${className}`}>
      {/* Messages Area */}
      <div className="ai-chat__messages">
        {messages.length === 0 ? (
          <div className="ai-chat__welcome">
            <Sparkles className="ai-chat__welcome-icon" />
            <h2>What would you like to build?</h2>
            <p>Describe your app idea and I'll help you create it</p>
            
            <div className="ai-chat__suggestions">
              {suggestedPrompts.map((prompt, index) => (
                <button
                  key={index}
                  className="ai-chat__suggestion"
                  onClick={() => setInput(prompt)}
                >
                  {prompt}
                </button>
              ))}
            </div>
          </div>
        ) : (
          messages.map((message) => (
            <MessageBubble
              key={message.id}
              message={message}
              onApplyCode={message.codeBlocks ? () => onApplyCode(message.codeBlocks!) : undefined}
            />
          ))
        )}
        
        {isLoading && (
          <div className="ai-chat__loading">
            <Loader2 className="animate-spin" />
            <span>Generating...</span>
          </div>
        )}
        
        <div ref={messagesEndRef} />
      </div>

      {/* Input Area - Fixed at bottom for mobile */}
      <form onSubmit={handleSubmit} className="ai-chat__input-area">
        <div className="ai-chat__input-wrapper">
          <textarea
            ref={inputRef}
            value={input}
            onChange={handleInputChange}
            onKeyDown={handleKeyDown}
            placeholder={
              remainingMessages > 0
                ? "Describe what you want to build..."
                : "No messages remaining. Upgrade your plan."
            }
            disabled={remainingMessages <= 0}
            rows={1}
            className="ai-chat__textarea"
          />
          
          <button
            type="submit"
            disabled={!input.trim() || isLoading || remainingMessages <= 0}
            className="ai-chat__send-btn"
          >
            {isLoading ? (
              <Loader2 className="animate-spin" size={20} />
            ) : (
              <Send size={20} />
            )}
          </button>
        </div>
        
        <div className="ai-chat__footer">
          <span className="ai-chat__remaining">
            {remainingMessages} messages remaining
          </span>
        </div>
      </form>
    </div>
  );
};
