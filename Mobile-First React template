## 13. `src/components/AIChat/MessageBubble.tsx`

```tsx
import React, { useState } from 'react';
import { User, Bot, Copy, Check, Play } from 'lucide-react';
import type { Message } from '../../types';

interface MessageBubbleProps {
  message: Message;
  onApplyCode?: () => void;
}

export const MessageBubble: React.FC<MessageBubbleProps> = ({
  message,
  onApplyCode,
}) => {
  const [copied, setCopied] = useState(false);
  const isUser = message.role === 'user';

  const handleCopy = async () => {
    await navigator.clipboard.writeText(message.content);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  // Parse content to render code blocks nicely
  const renderContent = () => {
    const parts = message.content.split(/(```[\s\S]*?```)/g);
    
    return parts.map((part, index) => {
      if (part.startsWith('```')) {
        const match = part.match(/```(\w+)?\n?([\s\S]*?)```/);
        if (match) {
          const [, language, code] = match;
          return (
            <div key={index} className="message-bubble__code-block">
              <div className="message-bubble__code-header">
                <span>{language || 'code'}</span>
                <button 
                  onClick={() => navigator.clipboard.writeText(code)}
                  className="message-bubble__code-copy"
                >
                  <Copy size={14} />
                </button>
              </div>
              <pre>
                <code>{code}</code>
              </pre>
            </div>
          );
        }
      }
      return <p key={index}>{part}</p>;
    });
  };

  return (
    <div className={`message-bubble ${isUser ? 'message-bubble--user' : 'message-bubble--assistant'}`}>
      <div className="message-bubble__avatar">
        {isUser ? <User size={18} /> : <Bot size={18} />}
      </div>
      
      <div className="message-bubble__content">
        {renderContent()}
        
        {!isUser && message.codeBlocks && message.codeBlocks.length > 0 && (
          <button 
            onClick={onApplyCode}
            className="message-bubble__apply-btn"
          >
            <Play size={16} />
            Apply {message.codeBlocks.length} file(s) to project
          </button>
        )}
      </div>

      {!isUser && (
        <button 
          onClick={handleCopy}
          className="message-bubble__copy"
          title="Copy message"
        >
          {copied ? <Check size={16} /> : <Copy size={16} />}
        </button>
      )}
    </div>
  );
};
