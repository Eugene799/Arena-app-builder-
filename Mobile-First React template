import { useState, useCallback } from 'react';
import type { Message, CodeBlock, AIProvider } from '../types';

interface AIConfig {
  provider: AIProvider;
  apiKey: string;
  model?: string;
}

const SYSTEM_PROMPT = `You are an expert full-stack developer AI assistant integrated into an app builder platform. 
Your role is to help users build web applications, websites, landing pages, and funnels.

When generating code:
1. Always use modern best practices (React 18+, TypeScript, Tailwind CSS)
2. Create complete, working code files
3. Format code blocks with the filename as a comment at the top
4. Consider mobile-first responsive design
5. Include necessary imports and exports

When asked to create an app, respond with:
- A brief explanation of the architecture
- All necessary code files wrapped in code blocks
- Instructions for any required setup

Available integrations: Stars Arena SDK, AVAX blockchain, WebContainers`;

export function useAI(config: AIConfig) {
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const parseCodeBlocks = useCallback((content: string): CodeBlock[] => {
    const codeBlockRegex = /```(\w+)?\s*\n?(?:\/\/\s*(\S+)\n)?([\s\S]*?)```/g;
    const blocks: CodeBlock[] = [];
    let match;

    while ((match = codeBlockRegex.exec(content)) !== null) {
      const language = match[1] || 'text';
      const filename = match[2] || `file.${language}`;
      const code = match[3].trim();
      
      blocks.push({ filename, language, code });
    }

    return blocks;
  }, []);

  const sendMessageGroq = useCallback(async (
    messages: Message[],
    apiKey: string
  ): Promise<string> => {
    const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: config.model || 'llama-3.3-70b-versatile',
        messages: [
          { role: 'system', content: SYSTEM_PROMPT },
          ...messages.map(m => ({ role: m.role, content: m.content })),
        ],
        temperature: 0.7,
        max_tokens: 8000,
      }),
    });

    if (!response.ok) {
      throw new Error(`Groq API error: ${response.statusText}`);
    }

    const data = await response.json();
    return data.choices[0].message.content;
  }, [config.model]);

  const sendMessageGemini = useCallback(async (
    messages: Message[],
    apiKey: string
  ): Promise<string> => {
    const { GoogleGenerativeAI } = await import('@google/generative-ai');
    const genAI = new GoogleGenerativeAI(apiKey);
    const model = genAI.getGenerativeModel({ 
      model: config.model || 'gemini-1.5-flash' 
    });

    const chat = model.startChat({
      history: messages.slice(0, -1).map(m => ({
        role: m.role === 'assistant' ? 'model' : 'user',
        parts: [{ text: m.content }],
      })),
    });

    const lastMessage = messages[messages.length - 1];
    const result = await chat.sendMessage(
      `${SYSTEM_PROMPT}\n\nUser: ${lastMessage.content}`
    );
    
    return result.response.text();
  }, [config.model]);

  const sendMessage = useCallback(async (
    messages: Message[]
  ): Promise<{ content: string; codeBlocks: CodeBlock[] }> => {
    setIsLoading(true);
    setError(null);

    try {
      let content: string;

      switch (config.provider) {
        case 'groq':
          content = await sendMessageGroq(messages, config.apiKey);
          break;
        case 'gemini':
          content = await sendMessageGemini(messages, config.apiKey);
          break;
        default:
          throw new Error(`Unsupported provider: ${config.provider}`);
      }

      const codeBlocks = parseCodeBlocks(content);
      return { content, codeBlocks };
    } catch (err) {
      const message = err instanceof Error ? err.message : 'AI request failed';
      setError(message);
      throw err;
    } finally {
      setIsLoading(false);
    }
  }, [config, sendMessageGroq, sendMessageGemini, parseCodeBlocks]);

  // Streaming support for real-time responses
  const streamMessage = useCallback(async function* (
    messages: Message[]
  ): AsyncGenerator<string> {
    if (config.provider !== 'groq') {
      throw new Error('Streaming only supported for Groq');
    }

    const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${config.apiKey}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: config.model || 'llama-3.3-70b-versatile',
        messages: [
          { role: 'system', content: SYSTEM_PROMPT },
          ...messages.map(m => ({ role: m.role, content: m.content })),
        ],
        stream: true,
      }),
    });

    const reader = response.body?.getReader();
    const decoder = new TextDecoder();

    if (!reader) throw new Error('No response body');

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      const chunk = decoder.decode(value);
      const lines = chunk.split('\n').filter(line => line.startsWith('data:'));

      for (const line of lines) {
        const data = line.replace('data: ', '');
        if (data === '[DONE]') return;

        try {
          const parsed = JSON.parse(data);
          const content = parsed.choices[0]?.delta?.content;
          if (content) yield content;
        } catch {
          // Skip invalid JSON
        }
      }
    }
  }, [config]);

  return {
    isLoading,
    error,
    sendMessage,
    streamMessage,
    parseCodeBlocks,
  };
}
