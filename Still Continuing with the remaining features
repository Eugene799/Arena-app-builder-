## `src/services/collaborationService.ts`

```typescript
import type { FileNode } from '../types';

export interface Collaborator {
  id: string;
  name: string;
  color: string;
  cursor?: { file: string; line: number; column: number };
  selection?: { start: number; end: number };
  isOnline: boolean;
  avatar?: string;
}

export interface CollaborationRoom {
  id: string;
  name: string;
  projectId: string;
  ownerId: string;
  collaborators: Collaborator[];
  createdAt: Date;
}

export interface SyncMessage {
  type: 'file-change' | 'cursor-move' | 'selection' | 'join' | 'leave' | 'chat';
  userId: string;
  payload: any;
  timestamp: number;
}

// CRDT-like operation for conflict-free editing
export interface Operation {
  id: string;
  type: 'insert' | 'delete';
  position: number;
  content?: string;
  length?: number;
  userId: string;
  timestamp: number;
}

const COLORS = [
  '#f38ba8', '#fab387', '#f9e2af', '#a6e3a1',
  '#94e2d5', '#89b4fa', '#cba6f7', '#f5c2e7',
];

export class CollaborationService {
  private peerConnection: RTCPeerConnection | null = null;
  private dataChannel: RTCDataChannel | null = null;
  private signalingWs: WebSocket | null = null;
  private roomId: string | null = null;
  private userId: string;
  private userName: string;
  private collaborators: Map<string, Collaborator> = new Map();
  private operationBuffer: Operation[] = [];
  private onMessageCallback: ((msg: SyncMessage) => void) | null = null;
  private onCollaboratorChangeCallback: ((collaborators: Collaborator[]) => void) | null = null;

  constructor() {
    this.userId = crypto.randomUUID();
    this.userName = `User ${Math.floor(Math.random() * 1000)}`;
  }

  // Set user info
  setUserInfo(name: string) {
    this.userName = name;
  }

  // Create a new collaboration room
  async createRoom(projectId: string, projectName: string): Promise<string> {
    const roomId = this.generateRoomId();
    this.roomId = roomId;

    await this.initializeConnection(roomId, true);

    return roomId;
  }

  // Join an existing room
  async joinRoom(roomId: string): Promise<void> {
    this.roomId = roomId;
    await this.initializeConnection(roomId, false);
  }

  // Leave the current room
  async leaveRoom(): Promise<void> {
    this.sendMessage({
      type: 'leave',
      userId: this.userId,
      payload: { name: this.userName },
      timestamp: Date.now(),
    });

    this.cleanup();
  }

  // Initialize WebRTC connection
  private async initializeConnection(roomId: string, isHost: boolean): Promise<void> {
    // Create peer connection with STUN/TURN servers
    this.peerConnection = new RTCPeerConnection({
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun1.l.google.com:19302' },
        // Add your TURN server here for production
      ],
    });

    // Set up data channel
    if (isHost) {
      this.dataChannel = this.peerConnection.createDataChannel('collaboration', {
        ordered: true,
      });
      this.setupDataChannel();
    } else {
      this.peerConnection.ondatachannel = (event) => {
        this.dataChannel = event.channel;
        this.setupDataChannel();
      };
    }

    // Handle ICE candidates
    this.peerConnection.onicecandidate = (event) => {
      if (event.candidate && this.signalingWs) {
        this.signalingWs.send(JSON.stringify({
          type: 'ice-candidate',
          roomId,
          candidate: event.candidate,
        }));
      }
    };

    // Connect to signaling server
    await this.connectSignaling(roomId, isHost);

    // Add self as collaborator
    const selfColor = COLORS[Math.floor(Math.random() * COLORS.length)];
    this.collaborators.set(this.userId, {
      id: this.userId,
      name: this.userName,
      color: selfColor,
      isOnline: true,
    });
  }

  // Connect to signaling server
  private async connectSignaling(roomId: string, isHost: boolean): Promise<void> {
    return new Promise((resolve, reject) => {
      // Replace with your signaling server URL
      const wsUrl = `wss://your-signaling-server.com/rooms/${roomId}`;
      
      // For demo, we'll use a mock implementation
      console.log(`Connecting to room: ${roomId}, isHost: ${isHost}`);
      
      // Mock successful connection
      setTimeout(() => {
        // Announce join
        this.sendMessage({
          type: 'join',
          userId: this.userId,
          payload: {
            name: this.userName,
            color: this.collaborators.get(this.userId)?.color,
          },
          timestamp: Date.now(),
        });
        resolve();
      }, 500);
    });
  }

  // Set up data channel handlers
  private setupDataChannel(): void {
    if (!this.dataChannel) return;

    this.dataChannel.onopen = () => {
      console.log('Data channel opened');
    };

    this.dataChannel.onmessage = (event) => {
      try {
        const message: SyncMessage = JSON.parse(event.data);
        this.handleMessage(message);
      } catch (error) {
        console.error('Failed to parse message:', error);
      }
    };

    this.dataChannel.onclose = () => {
      console.log('Data channel closed');
    };
  }

  // Handle incoming messages
  private handleMessage(message: SyncMessage): void {
    switch (message.type) {
      case 'join':
        const newCollaborator: Collaborator = {
          id: message.userId,
          name: message.payload.name,
          color: message.payload.color || COLORS[this.collaborators.size % COLORS.length],
          isOnline: true,
        };
        this.collaborators.set(message.userId, newCollaborator);
        this.notifyCollaboratorChange();
        break;

      case 'leave':
        this.collaborators.delete(message.userId);
        this.notifyCollaboratorChange();
        break;

      case 'cursor-move':
        const collaborator = this.collaborators.get(message.userId);
        if (collaborator) {
          collaborator.cursor = message.payload;
          this.notifyCollaboratorChange();
        }
        break;

      case 'file-change':
        // Apply the operation using CRDT logic
        this.applyOperation(message.payload);
        break;

      case 'selection':
        const collab = this.collaborators.get(message.userId);
        if (collab) {
          collab.selection = message.payload;
          this.notifyCollaboratorChange();
        }
        break;

      case 'chat':
        // Handle chat messages
        break;
    }

    // Notify callback
    if (this.onMessageCallback) {
      this.onMessageCallback(message);
    }
  }

  // Send a message to all peers
  sendMessage(message: SyncMessage): void {
    if (this.dataChannel?.readyState === 'open') {
      this.dataChannel.send(JSON.stringify(message));
    }
  }

  // Send file change
  sendFileChange(filePath: string, operation: Operation): void {
    this.operationBuffer.push(operation);

    this.sendMessage({
      type: 'file-change',
      userId: this.userId,
      payload: {
        filePath,
        operation,
      },
      timestamp: Date.now(),
    });
  }

  // Send cursor position
  sendCursorMove(file: string, line: number, column: number): void {
    this.sendMessage({
      type: 'cursor-move',
      userId: this.userId,
      payload: { file, line, column },
      timestamp: Date.now(),
    });
  }

  // Send selection
  sendSelection(file: string, start: number, end: number): void {
    this.sendMessage({
      type: 'selection',
      userId: this.userId,
      payload: { file, start, end },
      timestamp: Date.now(),
    });
  }

  // Apply operation (CRDT-like merge)
  private applyOperation(payload: { filePath: string; operation: Operation }): void {
    const { operation } = payload;

    // Transform operation against buffered operations
    const transformedOp = this.transformOperation(operation);

    // Notify callback to apply the change
    if (this.onMessageCallback) {
      this.onMessageCallback({
        type: 'file-change',
        userId: operation.userId,
        payload: { ...payload, operation: transformedOp },
        timestamp: Date.now(),
      });
    }
  }

  // Transform operation for conflict resolution (OT-like)
  private transformOperation(op: Operation): Operation {
    let transformed = { ...op };

    for (const bufferedOp of this.operationBuffer) {
      if (bufferedOp.timestamp < op.timestamp && bufferedOp.id !== op.id) {
        // Transform position based on buffered operation
        if (bufferedOp.type === 'insert' && bufferedOp.position <= transformed.position) {
          transformed.position += bufferedOp.content?.length || 0;
        } else if (bufferedOp.type === 'delete' && bufferedOp.position < transformed.position) {
          transformed.position -= Math.min(
            bufferedOp.length || 0,
            transformed.position - bufferedOp.position
          );
        }
      }
    }

    return transformed;
  }

  // Get current collaborators
  getCollaborators(): Collaborator[] {
    return Array.from(this.collaborators.values());
  }

  // Set message callback
  onMessage(callback: (msg: SyncMessage) => void): void {
    this.onMessageCallback = callback;
  }

  // Set collaborator change callback
  onCollaboratorChange(callback: (collaborators: Collaborator[]) => void): void {
    this.onCollaboratorChangeCallback = callback;
  }

  private notifyCollaboratorChange(): void {
    if (this.onCollaboratorChangeCallback) {
      this.onCollaboratorChangeCallback(this.getCollaborators());
    }
  }

  // Generate room ID
  private generateRoomId(): string {
    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
    let result = '';
    for (let i = 0; i < 8; i++) {
      result += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return result;
  }

  // Get shareable link
  getShareLink(): string {
    if (!this.roomId) return '';
    return `${window.location.origin}/collab/${this.roomId}`;
  }

  // Cleanup
  private cleanup(): void {
    this.dataChannel?.close();
    this.peerConnection?.close();
    this.signalingWs?.close();
    this.dataChannel = null;
    this.peerConnection = null;
    this.signalingWs = null;
    this.roomId = null;
    this.collaborators.clear();
    this.operationBuffer = [];
  }
}

export const collaborationService = new CollaborationService();
