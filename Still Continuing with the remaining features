    if (!joinCode.trim()) {
      toast.error('Please enter a room code');
      return;
    }

    try {
      await collaborationService.joinRoom(joinCode.trim());
      setRoomId(joinCode.trim());
      setIsConnected(true);
      toast.success('Joined collaboration room!');
