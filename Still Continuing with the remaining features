  const [roomId, setRoomId] = useState<string | null>(null);
  const [shareLink, setShareLink] = useState('');
  const [copied, setCopied] = useState(false);
  const [joinCode, setJoinCode] = useState('');

  useEffect(() => {
    collaborationService.onCollaboratorChange((collabs) => {
      setCollaborators(collabs);
    });
  }, []);

  const handleCreateRoom = async () => {
    try {
      const id = await collaborationService.createRoom(projectId, projectName);
      setRoomId(id);
      setShareLink(collaborationService.getShareLink());
      setIsConnected(true);
      toast.success('Collaboration room created!');
    } catch (error) {
      toast.error('Failed to create room');
    }
