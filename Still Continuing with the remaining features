import type { FileNode } from '../types';

export interface Commit {
  id: string;
  message: string;
  timestamp: Date;
  author: string;
  parentId: string | null;
  snapshot: FileSnapshot[];
  diff: FileDiff[];
}

export interface FileSnapshot {
  path: string;
  content: string;
  hash: string;
}

export interface FileDiff {
  path: string;
  type: 'added' | 'modified' | 'deleted';
  additions: number;
  deletions: number;
  hunks: DiffHunk[];
}

export interface DiffHunk {
  oldStart: number;
  oldLines: number;
  newStart: number;
  newLines: number;
  lines: DiffLine[];
}

export interface DiffLine {
  type: 'context' | 'add' | 'delete';
  content: string;
  oldLineNumber?: number;
  newLineNumber?: number;
}

export interface Branch {
  name: string;
  headCommitId: string;
  isActive: boolean;
}

export class VersionControlService {
  private commits: Map<string, Commit> = new Map();
  private branches: Map<string, Branch> = new Map();
  private currentBranch: string = 'main';
  private stagingArea: Map<string, string> = new Map(); // path -> content

  constructor() {
    // Initialize main branch
    this.branches.set('main', {
      name: 'main',
      headCommitId: '',
      isActive: true,
    });
  }

  // Create initial commit
  initRepository(files: FileNode[], author: string): Commit {
    const snapshot = this.createSnapshot(files);
    const commit = this.createCommit('Initial commit', author, snapshot, null);
    
    // Update branch head
    const branch = this.branches.get(this.currentBranch);
    if (branch) {
      branch.headCommitId = commit.id;
    }

    return commit;
  }

  // Stage files for commit
  stageFile(path: string, content: string): void {
    this.stagingArea.set(path, content);
  }

  // Unstage file
  unstageFile(path: string): void {
    this.stagingArea.delete(path);
  }

  // Clear staging area
  clearStaging(): void {
    this.stagingArea.clear();
  }

  // Get staged files
  getStagedFiles(): { path: string; content: string }[] {
    return Array.from(this.stagingArea.entries()).map(([path, content]) => ({
      path,
      content,
    }));
  }

  // Create a commit
  commit(message: string, author: string, currentFiles: FileNode[]): Commit {
    const parentCommit = this.getCurrentCommit();
    const snapshot = this.createSnapshot(currentFiles);
    const diff = parentCommit 
      ? this.calculateDiff(parentCommit.snapshot, snapshot)
      : snapshot.map(s => ({
          path: s.path,
          type: 'added' as const,
          additions: s.content.split('\n').length,
          deletions: 0,
          hunks: [],
        }));

    const commit = this.createCommit(
      message,
      author,
      snapshot,
      parentCommit?.id || null,
      diff
    );

    // Update branch head
    const branch = this.branches.get(this.currentBranch);
    if (branch) {
      branch.headCommitId = commit.id;
    }

    // Clear staging area
    this.clearStaging();

    return commit;
  }

  // Get current commit
  getCurrentCommit(): Commit | null {
    const branch = this.branches.get(this.currentBranch);
    if (!branch || !branch.headCommitId) return null;
    return this.commits.get(branch.headCommitId) || null;
  }

  // Get commit history
  getHistory(limit?: number): Commit[] {
    const history: Commit[] = [];
    let current = this.getCurrentCommit();

    while (current && (!limit || history.length < limit)) {
      history.push(current);
      current = current.parentId 
        ? this.commits.get(current.parentId) || null 
        : null;
    }

    return history;
  }

  // Get commit by ID
  getCommit(id: string): Commit | null {
    return this.commits.get(id) || null;
  }

  // Checkout a specific commit
  checkout(commitId: string): FileNode[] {
    const commit = this.commits.get(commitId);
    if (!commit) throw new Error('Commit not found');

    return this.snapshotToFileTree(commit.snapshot);
  }

  // Create a new branch
  createBranch(name: string): Branch {
    const currentCommit = this.getCurrentCommit();
    const branch: Branch = {
      name,
      headCommitId: currentCommit?.id || '',
      isActive: false,
    };

    this.branches.set(name, branch);
    return branch;
  }

  // Switch branch
  switchBranch(name: string): FileNode[] | null {
    const branch = this.branches.get(name);
    if (!branch) return null;

    // Deactivate current branch
    const currentBranch = this.branches.get(this.currentBranch);
    if (currentBranch) {
      currentBranch.isActive = false;
    }

    // Activate new branch
    branch.isActive = true;
    this.currentBranch = name;

    // Return files at branch head
    if (branch.headCommitId) {
      return this.checkout(branch.headCommitId);
    }

    return null;
  }

