import React, { useState } from 'react';
import { Search, Lock, Sparkles, X } from 'lucide-react';
import { PROJECT_TEMPLATES, type ProjectTemplate } from '../../data/templates';
import './TemplateSelector.css';

interface TemplateSelectorProps {
  isOpen: boolean;
  onClose: () => void;
  onSelectTemplate: (template: ProjectTemplate) => void;
  isPremiumUser: boolean;
}

type Category = 'all' | ProjectTemplate['category'];

export const TemplateSelector: React.FC<TemplateSelectorProps> = ({
  isOpen,
  onClose,
  onSelectTemplate,
  isPremiumUser,
}) => {
  const [search, setSearch] = useState('');
  const [category, setCategory] = useState<Category>('all');

  const categories: { id: Category; label: string; icon: string }[] = [
    { id: 'all', label: 'All Templates', icon: '📁' },
    { id: 'landing', label: 'Landing Pages', icon: '🚀' },
    { id: 'portfolio', label: 'Portfolios', icon: '👨‍💻' },
    { id: 'ecommerce', label: 'E-Commerce', icon: '🛒' },
    { id: 'dashboard', label: 'Dashboards', icon: '📊' },
    { id: 'blog', label: 'Blogs', icon: '📝' },
    { id: 'saas', label: 'SaaS', icon: '💼' },
  ];

  const filteredTemplates = PROJECT_TEMPLATES.filter(template => {
    const matchesSearch = template.name.toLowerCase().includes(search.toLowerCase()) ||
      template.description.toLowerCase().includes(search.toLowerCase()) ||
      template.tags.some(tag => tag.toLowerCase().includes(search.toLowerCase()));
    
    const matchesCategory = category === 'all' || template.category === category;
    
    return matchesSearch && matchesCategory;
  });

  const handleSelectTemplate = (template: ProjectTemplate) => {
    if (template.isPremium && !isPremiumUser) {
      // Show upgrade prompt
      alert('This template requires a Pro or Premium subscription');
      return;
    }
    onSelectTemplate(template);
    onClose();
  };

  if (!isOpen) return null;

  return (
    <div className="template-selector__overlay" onClick={onClose}>
      <div className="template-selector" onClick={e => e.stopPropagation()}>
        <div className="template-selector__header">
          <h2>Choose a Template</h2>
          <button className="template-selector__close" onClick={onClose}>
            <X size={20} />
          </button>
        </div>

        <div className="template-selector__search">
          <Search size={18} />
          <input
            type="text"
            placeholder="Search templates..."
            value={search}
            onChange={e => setSearch(e.target.value)}
          />
        </div>

        <div className="template-selector__body">
          <nav className="template-selector__categories">
            {categories.map(cat => (
              <button
                key={cat.id}
                className={`template-selector__category ${category === cat.id ? 'active' : ''}`}
                onClick={() => setCategory(cat.id)}
              >
                <span>{cat.icon}</span>
                <span>{cat.label}</span>
              </button>
            ))}
          </nav>

          <div className="template-selector__grid">
            {/* Blank Project */}
            <button
              className="template-card template-card--blank"
              onClick={() => onSelectTemplate({
                id: 'blank',
                name: 'Blank Project',
                description: 'Start from scratch',
                category: 'landing',
                thumbnail: '➕',
                tags: [],
                files: [],
                isPremium: false,
              })}
            >
              <div className="template-card__preview">
                <span className="text-4xl">➕</span>
              </div>
              <div className="template-card__info">
                <h3>Blank Project</h3>
                <p>Start from scratch with AI assistance</p>
              </div>
            </button>

            {filteredTemplates.map(template => (
              <button
                key={template.id}
                className={`template-card ${template.isPremium && !isPremiumUser ? 'template-card--locked' : ''}`}
                onClick={() => handleSelectTemplate(template)}
              >
                {template.isPremium && (
                  <div className="template-card__badge">
                    <Sparkles size={12} />
                    Premium
                  </div>
                )}
                
                <div className="template-card__preview">
                  <span className="text-5xl">{template.thumbnail}</span>
                  {template.isPremium && !isPremiumUser && (
                    <div className="template-card__lock">
                      <Lock size={24} />
                    </div>
                  )}
                </div>
                
                <div className="template-card__info">
                  <h3>{template.name}</h3>
                  <p>{template.description}</p>
                  <div className="template-card__tags">
                    {template.tags.slice(0, 3).map(tag => (
                      <span key={tag}>{tag}</span>
                    ))}
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};
