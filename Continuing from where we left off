```tsx
import React, { useState, useCallback } from 'react';
import { 
  PanelLeftClose, 
  PanelLeftOpen,
  PanelBottomClose,
  PanelBottomOpen,
  Settings,
  Wallet,
} from 'lucide-react';
import './Layout.css';

interface DesktopLayoutProps {
  chatPanel: React.ReactNode;
  codePanel: React.ReactNode;
  filesPanel: React.ReactNode;
  previewPanel: React.ReactNode;
  terminalPanel: React.ReactNode;
  walletPanel?: React.ReactNode;
  onOpenSettings?: () => void;
}

export const DesktopLayout: React.FC<DesktopLayoutProps> = ({
  chatPanel,
  codePanel,
  filesPanel,
  previewPanel,
  terminalPanel,
  walletPanel,
  onOpenSettings,
}) => {
  const [showSidebar, setShowSidebar] = useState(true);
  const [showTerminal, setShowTerminal] = useState(true);
  const [showWallet, setShowWallet] = useState(false);
  const [splitRatio, setSplitRatio] = useState(50); // Code vs Preview split

  const handleDrag = useCallback((e: React.MouseEvent) => {
    const startX = e.clientX;
    const startRatio = splitRatio;
    const container = document.querySelector('.desktop-layout__main') as HTMLElement;
    
    if (!container) return;

    const handleMouseMove = (moveEvent: MouseEvent) => {
      const deltaX = moveEvent.clientX - startX;
      const containerWidth = container.offsetWidth;
      const newRatio = startRatio + (deltaX / containerWidth) * 100;
      setSplitRatio(Math.max(20, Math.min(80, newRatio)));
    };

    const handleMouseUp = () => {
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
    };

    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
  }, [splitRatio]);

  return (
    <div className="desktop-layout">
      {/* Header */}
      <header className="desktop-layout__header">
        <div className="desktop-layout__header-left">
          <button 
            className="desktop-layout__toggle-btn"
            onClick={() => setShowSidebar(!showSidebar)}
            title={showSidebar ? 'Hide sidebar' : 'Show sidebar'}
          >
            {showSidebar ? <PanelLeftClose size={20} /> : <PanelLeftOpen size={20} />}
          </button>
          <h1 className="desktop-layout__title">
            <span className="desktop-layout__logo">🚀</span>
            Arena AI Builder
          </h1>
        </div>

        <div className="desktop-layout__header-right">
          <button 
            className={`desktop-layout__wallet-btn ${showWallet ? 'active' : ''}`}
            onClick={() => setShowWallet(!showWallet)}
          >
            <Wallet size={18} />
            <span>Wallet</span>
          </button>
          <button 
            className="desktop-layout__toggle-btn"
            onClick={() => setShowTerminal(!showTerminal)}
            title={showTerminal ? 'Hide terminal' : 'Show terminal'}
          >
            {showTerminal ? <PanelBottomClose size={20} /> : <PanelBottomOpen size={20} />}
          </button>
          <button 
            className="desktop-layout__settings-btn"
            onClick={onOpenSettings}
          >
            <Settings size={20} />
          </button>
        </div>
      </header>

      <div className="desktop-layout__body">
        {/* AI Chat Sidebar */}
        {showSidebar && (
          <aside className="desktop-layout__sidebar desktop-layout__sidebar--left">
            {chatPanel}
          </aside>
        )}

        {/* Main Editor Area */}
        <div className="desktop-layout__main">
          {/* Files + Code */}
          <div 
            className="desktop-layout__code-area"
            style={{ width: `${splitRatio}%` }}
          >
            <div className="desktop-layout__files">
              {filesPanel}
            </div>
            <div className="desktop-layout__editor">
              {codePanel}
            </div>
          </div>

          {/* Resize Handle */}
          <div 
            className="desktop-layout__resize-handle"
            onMouseDown={handleDrag}
          />

          {/* Preview */}
          <div 
            className="desktop-layout__preview-area"
            style={{ width: `${100 - splitRatio}%` }}
          >
            {previewPanel}
          </div>
        </div>

        {/* Wallet Sidebar */}
        {showWallet && (
          <aside className="desktop-layout__sidebar desktop-layout__sidebar--right">
            {walletPanel}
          </aside>
        )}
      </div>

      {/* Terminal */}
      {showTerminal && (
        <div className="desktop-layout__terminal">
          {terminalPanel}
        </div>
      )}
    </div>
  );
};
