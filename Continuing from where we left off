import React, { useState, useCallback } from 'react';
import { 
  Code, 
  MessageSquare, 
  FolderTree, 
  Play, 
  Terminal as TerminalIcon,
  Menu,
  X,
  Wallet,
  Settings,
} from 'lucide-react';
import { useVisualViewport } from '../../hooks/useVisualViewport';
import './Layout.css';

type MobileTab = 'chat' | 'code' | 'files' | 'preview' | 'terminal';

interface MobileLayoutProps {
  chatPanel: React.ReactNode;
  codePanel: React.ReactNode;
  filesPanel: React.ReactNode;
  previewPanel: React.ReactNode;
  terminalPanel: React.ReactNode;
  walletPanel?: React.ReactNode;
  onOpenSettings?: () => void;
}

export const MobileLayout: React.FC<MobileLayoutProps> = ({
  chatPanel,
  codePanel,
  filesPanel,
  previewPanel,
  terminalPanel,
  walletPanel,
  onOpenSettings,
}) => {
  const [activeTab, setActiveTab] = useState<MobileTab>('chat');
  const [showSidebar, setShowSidebar] = useState(false);
  const viewport = useVisualViewport();

  const tabs: { id: MobileTab; icon: React.ReactNode; label: string }[] = [
    { id: 'chat', icon: <MessageSquare size={20} />, label: 'AI' },
    { id: 'code', icon: <Code size={20} />, label: 'Code' },
    { id: 'files', icon: <FolderTree size={20} />, label: 'Files' },
    { id: 'preview', icon: <Play size={20} />, label: 'Preview' },
    { id: 'terminal', icon: <TerminalIcon size={20} />, label: 'Terminal' },
  ];

  const renderPanel = useCallback(() => {
    switch (activeTab) {
      case 'chat':
        return chatPanel;
      case 'code':
        return codePanel;
      case 'files':
        return filesPanel;
      case 'preview':
        return previewPanel;
      case 'terminal':
        return terminalPanel;
      default:
        return null;
    }
  }, [activeTab, chatPanel, codePanel, filesPanel, previewPanel, terminalPanel]);

  return (
    <div 
      className="mobile-layout"
      style={{ 
        height: viewport.isKeyboardOpen ? `${viewport.height}px` : '100dvh',
