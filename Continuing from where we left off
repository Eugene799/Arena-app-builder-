      {/* Sidebar */}
      {showSidebar && (
        <div className="mobile-layout__sidebar-overlay" onClick={() => setShowSidebar(false)}>
          <aside 
            className="mobile-layout__sidebar"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="mobile-layout__sidebar-header">
              <h2>Menu</h2>
              <button onClick={() => setShowSidebar(false)}>
