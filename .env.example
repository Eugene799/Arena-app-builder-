# API Keys
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_LEONARDO_API_KEY=

# Deployment
VITE_VERCEL_TOKEN=
VITE_NETLIFY_TOKEN=

# Blockchain
VITE_AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_AVAX_CHAIN_ID=43113
VITE_AVAX_CHAIN_ID_HEX=0xa869

# Additional Blockchain RPC URLs
VITE_ETH_RPC_URL=https://eth.llamarpc.com
VITE_POLYGON_RPC_URL=https://polygon.llamarpc.com
VITE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC

# Feature Flags
VITE_ENABLE_ONBOARDING=true
VITE_SHOW_FEE_CALCULATOR=true
VITE_ENABLE_TEMPLATES=true
VITE_ENABLE_MULTICHAIN_WALLET=true
VITE_ARENA_SDK_ENABLED=true

# Rate Limiting
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

# Reown AppKit (Multi-Chain Wallet Support)
# Get your project ID at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=
