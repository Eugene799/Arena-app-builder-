# ========================================
# ARENA AI BUILDER - REQUIRED ENVIRONMENT VARIABLES
# ========================================
# These variables are REQUIRED for the builder to function properly.
# Set them at build time (VITE_ prefix means they're bundled into the build).

# Application Metadata
VITE_APP_NAME=Arena AI Builder
VITE_APP_URL=https://arena-ai-builder.app

# API Keys (at least one AI provider key recommended)
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_LEONARDO_API_KEY=

# Deployment Platform Tokens
VITE_VERCEL_TOKEN=
VITE_NETLIFY_TOKEN=

# Blockchain Configuration (Avalanche)
VITE_AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_AVAX_CHAIN_ID=43113
VITE_AVAX_CHAIN_ID_HEX=0xa869

# ========================================
# OPTIONAL FEATURE FLAG VARIABLES
# ========================================
# These have sensible defaults and can be omitted.

# Feature Flags
VITE_ENABLE_ONBOARDING=true
VITE_SHOW_FEE_CALCULATOR=true
VITE_ENABLE_TEMPLATES=true

# Rate Limiting
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

# ========================================
# USER PROJECT VARIABLES (dApp Building)
# ========================================
# These are OPTIONAL suggestions for users building dApps.
# They are NOT required for the builder itself.
# Users can add these through the EnvVarsManager component.

# Blockchain RPC URLs (optional)
# SEPOLIA_RPC_URL=
# BASE_RPC_URL=
# SOLANA_RPC_URL=
# POLYGON_RPC_URL=
# ARBITRUM_RPC_URL=

# External API Keys (optional)
# ALCHEMY_API_KEY=
# QUICKNODE_API_KEY=
# INFURA_API_KEY=
# MORALIS_API_KEY=

# Database Connections (optional)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# NEON_CONNECTION_STRING=
# MONGODB_URI=
# REDIS_URL=

# Authentication (optional)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# File Storage (optional)
# PINATA_API_KEY=
# PINATA_SECRET_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
